# Cloudflare Pages header rules. Applied in order; later rules do not override earlier ones.

# Vite content-hashes everything under /assets, so these are safe to freeze forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The GLB is NOT content-hashed — it is a stable path served out of public/.
# A day of hard caching with a week of stale-while-revalidate means a repushed
# model reaches returning visitors within 24h without costing a round trip on
# every load. Do not mark this immutable until the filename carries a hash.
/models/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
